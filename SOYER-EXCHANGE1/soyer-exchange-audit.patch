+/* SOYER EXCHANGE — Dark Premium
+   Один файл без !important. Правила адаптивності:
+   - жодних 100vw / фіксованих ширин у макеті;
+   - гнучкі елементи мають min-width:0, довгий текст переноситься;
+   - safe-area враховується через env() (потрібен viewport-fit=cover). */
+
+:root {
+  --bg: #080a0f;
+  --text: #eef7ef;
+  --muted: #8793a7;
+  --accent: #aabaff;
+  --accent-strong: #b9c7ff;
+  --ok: #52d6a6;
+  --warn: #f2d58b;
+  --danger: #ffaaaa;
+  --gutter: max(17px, env(safe-area-inset-left), env(safe-area-inset-right));
+  --font-body: "DM Sans Variable", "Manrope Variable", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  --font-head: "Manrope Variable", "DM Sans Variable", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+  text-size-adjust: 100%;
+  background: var(--bg);
+}
+
+body {
+  margin: 0;
+  background:
+    radial-gradient(ellipse at 75% 20%, rgba(76, 85, 176, 0.15), transparent 42%),
+    var(--bg);
+  color: var(--text);
+  font-family: var(--font-body);
+}
+
+button,
+input,
+textarea {
+  font-family: inherit;
+}
+
+button {
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+}
+
+button:disabled {
+  cursor: not-allowed;
+}
+
+:focus-visible {
+  outline: 2px solid rgba(136, 156, 255, 0.7);
+  outline-offset: 2px;
+}
+
+/* ---------- Каркас ---------- */
+
+.app {
+  max-width: 520px;
+  min-height: 100vh;
+  min-height: 100dvh;
+  margin: 0 auto;
+  padding: 0 var(--gutter) calc(96px + env(safe-area-inset-bottom));
+}
+
+/* ---------- Шапка ----------
+   Шапка на всю ширину .app (від краю до краю), щоб контент, який
+   прокручується під нею, не просвічував у бічних полях. */
+
+header {
+  position: sticky;
+  top: 0;
+  z-index: 5;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  height: 72px;
+  margin: 0 calc(-1 * var(--gutter));
+  padding: 0 var(--gutter);
+  border-bottom: 1px solid #ffffff12;
+  background: rgba(8, 10, 15, 0.92);
+  -webkit-backdrop-filter: blur(15px);
+  backdrop-filter: blur(15px);
+}
+
+.logo {
+  flex: none;
+  display: grid;
+  place-items: center;
+  width: 38px;
+  height: 38px;
+  border-radius: 13px;
+  background: linear-gradient(145deg, rgba(108, 140, 255, 0.25), rgba(156, 121, 255, 0.12));
+  color: var(--accent-strong);
+}
+
+.logo svg {
+  width: 22px;
+  height: 22px;
+}
+
+.brand {
+  flex: 1 1 auto;
+  min-width: 0;
+}
+
+.brand b {
+  display: block;
+  font: 800 14px/1.2 var(--font-head);
+  letter-spacing: 0.06em;
+  white-space: nowrap;
+  text-overflow: ellipsis; /* лише запобіжник на екстремально вузьких екранах */
+  overflow: hidden;
+}
+
+.brand i {
+  color: #a18aff;
+  font-style: normal;
+}
+
+.brand small {
+  display: block;
+  margin-top: 2px;
+  color: #78849a;
+  font-size: 8px;
+  letter-spacing: 0.18em;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+  overflow: hidden;
+}
+
+.online {
+  flex: none;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  color: var(--ok);
+  font-size: 10px;
+  font-weight: 600;
+  letter-spacing: 0.04em;
+  white-space: nowrap;
+}
+
+.online::before {
+  content: "";
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: var(--ok);
+  box-shadow: 0 0 0 0 rgba(82, 214, 166, 0.5);
+  animation: pulse 2.4s ease-out infinite;
+}
+
+@keyframes pulse {
+  0% { box-shadow: 0 0 0 0 rgba(82, 214, 166, 0.5); }
+  70%, 100% { box-shadow: 0 0 0 7px rgba(82, 214, 166, 0); }
+}
+
+/* ---------- Головна ---------- */
+
+.hero {
+  padding: 32px 3px 20px;
+}
+
+.hero > small,
+.title small,
+.section small {
+  color: #8498e9;
+  font-size: 9px;
+  font-weight: 700;
+  letter-spacing: 0.2em;
+}
+
+.hero h1,
+.title h1 {
+  margin: 13px 0;
+  font: 800 clamp(32px, 11vw, 42px) / 1.08 var(--font-head);
+  overflow-wrap: anywhere;
+}
+
+.hero h1 em {
+  color: #9db3ff;
+  font-style: normal;
+}
+
+.hero p {
+  margin: 0;
+  color: #9da8bb;
+  font-size: 13px;
+  line-height: 1.6;
+}
+
+.rates {
+  display: flex;
+  margin-top: 20px;
+  padding: 17px;
+  border: 1px solid rgba(139, 158, 218, 0.18);
+  border-radius: 17px;
+  background: linear-gradient(120deg, #151d2c, #111724);
+}
+
+.rates > div {
+  flex: 1;
+  min-width: 0;
+}
+
+.rates > div + div {
+  padding-left: 15px;
+  border-left: 1px solid #ffffff24;
+}
+
+.rates label {
+  display: block;
+  margin-bottom: 7px;
+  color: #a4b1d0;
+  font-size: 10px;
+}
+
+.rates b {
+  display: block;
+  color: var(--accent-strong);
+  font: 800 clamp(17px, 5.6vw, 21px) var(--font-head);
+  white-space: nowrap;
+}
+
+.hint {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin-top: 10px;
+  color: #8994a8;
+  font-size: 10px;
+}
+
+.hint svg {
+  flex: none;
+}
+
+/* ---------- Панелі та калькулятор ---------- */
+
+.panel {
+  margin: 12px 0 20px;
+  padding: 18px;
+  border: 1px solid #ffffff14;
+  border-radius: 20px;
+  background: linear-gradient(145deg, #151d2a, #101621);
+}
+
+.section {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  margin-bottom: 18px;
+}
+
+.section > div {
+  min-width: 0;
+}
+
+.section h2,
+.panel h2 {
+  margin: 5px 0 12px;
+  font: 700 18px var(--font-head);
+}
+
+.section h2 {
+  margin-bottom: 0;
+}
+
+.pill {
+  flex: none;
+  padding: 6px 8px;
+  border: 1px solid rgba(136, 156, 255, 0.23);
+  border-radius: 20px;
+  color: var(--accent);
+  font-size: 8px;
+  white-space: nowrap;
+}
+
+.panel label {
+  display: block;
+  margin: 13px 0 8px;
+  color: #8592a9;
+  font-size: 11px;
+}
+
+.switch {
+  display: flex;
+  gap: 5px;
+  padding: 4px;
+  border-radius: 11px;
+  background: #0c111b;
+}
+
+.switch button {
+  flex: 1;
+  min-width: 0;
+  padding: 11px 3px;
+  border: 0;
+  border-radius: 8px;
+  background: none;
+  color: #7e8ba2;
+  font-size: 11px;
+  font-weight: 700;
+  transition: background 0.2s, color 0.2s;
+}
+
+.switch .sel {
+  background: linear-gradient(100deg, rgba(105, 135, 255, 0.23), rgba(145, 116, 255, 0.17));
+  color: #dbe2ff;
+}
+
+.amount {
+  margin-top: 12px;
+  padding: 13px;
+  border: 1px solid #ffffff17;
+  border-radius: 12px;
+  background: #0d131e;
+}
+
+.amount small {
+  color: #8290a8;
+  font-size: 10px;
+}
+
+.amount > div {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  margin-top: 7px;
+}
+
+.amount input {
+  flex: 1 1 auto;
+  width: 100%;
+  min-width: 0;
+  padding: 0;
+  border: 0;
+  outline: 0;
+  background: none;
+  color: #fff;
+  font: 700 clamp(20px, 6.6vw, 25px) var(--font-head);
+}
+
+.amount input::placeholder {
+  color: #4a566c;
+}
+
+.amount b {
+  flex: none;
+  padding: 8px;
+  border-radius: 8px;
+  background: rgba(120, 143, 255, 0.09);
+  color: var(--accent-strong);
+  font-size: 11px;
+}
+
+.amount:focus-within {
+  border-color: rgba(136, 156, 255, 0.45);
+}
+
+.receive {
+  border-color: rgba(145, 163, 218, 0.25);
+  background: rgba(79, 112, 202, 0.07);
+}
+
+.swap {
+  position: relative;
+  z-index: 1;
+  display: grid;
+  place-items: center;
+  width: 34px;
+  height: 34px;
+  margin: -14px auto;
+  padding: 0;
+  border: 3px solid #121a27;
+  border-radius: 11px;
+  background: #1f2c4d;
+  color: #a5b4ff;
+  transition: transform 0.25s;
+}
+
+.swap svg {
+  width: 16px;
+  height: 16px;
+}
+
+.swap:active {
+  transform: rotate(180deg);
+}
+
+.swap + .amount {
+  margin-top: 0;
+}
+
+.calc-msg {
+  min-height: 16px;
+  margin: 10px 2px 0;
+  font-size: 11px;
+  line-height: 1.4;
 }
+
+.calc-msg.error {
+  color: var(--warn);
+}
+
+.calc-msg.info {
+  color: var(--muted);
+}
+
+.text {
+  width: 100%;
+  margin: 4px 0;
+  padding: 12px;
+  border: 1px solid #ffffff1c;
+  border-radius: 10px;
+  background: #0d131e;
+  color: #fff;
+  font-size: 16px; /* 16px — iOS не масштабує сторінку при фокусі */
+  outline: none;
+}
+
+.text:focus {
+  border-color: rgba(136, 156, 255, 0.45);
+}
+
+textarea.text {
+  min-height: 84px;
+  resize: vertical;
+}
+
+.primary {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  width: 100%;
+  margin-top: 13px;
+  padding: 14px;
+  border: 0;
+  border-radius: 11px;
+  background: linear-gradient(105deg, #6688ff, #8d70f4);
+  color: #fff;
+  font-size: 14px;
+  font-weight: 800;
+}
+
+.primary:active:not(:disabled) {
+  opacity: 0.88;
+}
+
+.primary:disabled {
+  opacity: 0.45;
+}
+
+.disclaimer {
+  margin: 12px 0 0;
+  color: #6f7c91;
+  font-size: 9px;
+  line-height: 1.5;
+  text-align: center;
+}
+
+.features {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 8px;
+}
+
+.features > div {
+  display: grid;
+  gap: 6px;
+  min-width: 0;
+  padding: 12px;
+  border: 1px solid #ffffff12;
+  border-radius: 12px;
+  background: #111722;
+}
+
+.features > div:last-child:nth-child(odd) {
+  grid-column: 1 / -1;
+}
+
+.features svg {
+  width: 18px;
+  color: #9aabff;
+}
+
+.features b {
+  font-size: 11px;
+}
+
+.features small {
+  color: #78849a;
+  font-size: 9px;
+  overflow-wrap: anywhere;
+}
+
+/* ---------- Акції / профіль ---------- */
+
+.title {
+  padding: 28px 3px 14px;
+}
+
+.title h1 {
+  font-size: clamp(26px, 8.6vw, 32px);
+}
+
+.order {
+  margin: 10px 0;
+  padding: 14px;
+  border: 1px solid #ffffff15;
+  border-radius: 14px;
+  background: #111824;
+  min-width: 0;
+}
+
+.order svg {
+  color: #9aabff;
+}
+
+.order h3 {
+  margin: 14px 0 5px;
+  font-size: 14px;
+  overflow-wrap: anywhere;
+}
+
+.order p {
+  margin: 0;
+  color: var(--muted);
+  font-size: 11px;
+  line-height: 1.5;
+  overflow-wrap: anywhere;
+  white-space: pre-line;
+}
+
+.empty {
+  display: grid;
+  justify-items: center;
+  gap: 12px;
+  padding: 50px 10px;
+  color: #94a999;
+  text-align: center;
+}
+
+.profile {
+  padding: 28px 18px;
+  text-align: center;
+}
+
+.profile svg {
+  color: #a6b5ff;
+}
+
+.profile h2 {
+  overflow-wrap: anywhere;
+}
+
+.profile p {
+  margin: 4px 0;
+  color: var(--muted);
+  font-size: 12px;
+  overflow-wrap: anywhere;
+}
+
+.outline {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  width: 100%;
+  margin-top: 10px;
+  padding: 12px;
+  border: 1px solid rgba(135, 154, 218, 0.18);
+  border-radius: 10px;
+  background: rgba(120, 143, 255, 0.09);
+  color: var(--accent-strong);
+  font-size: 12px;
+  font-weight: 600;
+}
+
+.outline:disabled {
+  opacity: 0.55;
+}
+
+.spin {
+  animation: spin 0.9s linear infinite;
+}
+
+@keyframes spin {
+  to { transform: rotate(360deg); }
+}
+
+/* ---------- Сповіщення ---------- */
+
+.notice {
+  position: sticky;
+  top: 76px;
+  z-index: 8;
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 10px;
+  width: 100%;
+  margin-top: 8px;
+  padding: 12px;
+  border: 1px solid rgba(130, 153, 255, 0.25);
+  border-radius: 10px;
+  background: #182235;
+  color: inherit;
+  font-size: 12px;
+  line-height: 1.4;
+  text-align: left;
+  overflow-wrap: anywhere;
+}
+
+.notice span:last-child {
+  flex: none;
+  color: var(--muted);
+}
+
+/* ---------- Адмінпанель ---------- */
+
+.delete-promo {
+  width: 100%;
+  margin-top: 12px;
+  padding: 10px 12px;
+  border: 1px solid rgba(255, 115, 115, 0.28);
+  border-radius: 9px;
+  background: rgba(255, 85, 85, 0.09);
+  color: var(--danger);
+  font-size: 11px;
+  font-weight: 700;
+}
+
+.delete-promo:active:not(:disabled) {
+  opacity: 0.75;
+}
+
+.delete-promo:disabled {
+  opacity: 0.5;
+}
+
+.admin-promos-heading {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+}
+
+.admin-promos-heading h2 {
+  margin-bottom: 8px;
+}
+
+.admin-promos-heading span {
+  color: var(--muted);
+  font-size: 10px;
+  white-space: nowrap;
+}
+
+.admin-promos-list {
+  display: grid;
+  gap: 10px;
+  margin-top: 8px;
+}
+
+.admin-promo {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-width: 0;
+  padding: 12px;
+  border: 1px solid #ffffff14;
+  border-radius: 12px;
+  background: #0d131e;
+}
+
+.admin-promo-copy {
+  flex: 1;
+  min-width: 0;
+}
+
+.admin-promo-copy b {
+  display: block;
+  font-size: 13px;
+  overflow-wrap: anywhere;
+}
+
+.admin-promo-copy p {
+  margin: 5px 0;
+  color: var(--muted);
+  font-size: 11px;
+  line-height: 1.45;
+  overflow-wrap: anywhere;
+}
+
+.admin-promo-copy small {
+  color: #68758b;
+  font-size: 9px;
+}
+
+.admin-promo .delete-promo {
+  flex: 0 0 auto;
+  width: auto;
+  margin: 0;
+}
+
+.admin-promos-empty {
+  padding: 18px 8px;
+  color: var(--muted);
+  font-size: 12px;
+  text-align: center;
+}
+
+/* ---------- Нижня навігація ---------- */
+
+nav {
+  position: fixed;
+  bottom: 0;
+  left: 50%;
+  z-index: 10;
+  display: flex;
+  justify-content: space-around;
+  width: min(520px, 100%);
+  padding: 8px 5px calc(8px + env(safe-area-inset-bottom));
+  border-top: 1px solid #ffffff14;
+  background: rgba(8, 11, 17, 0.96);
+  -webkit-backdrop-filter: blur(18px);
+  backdrop-filter: blur(18px);
+  transform: translateX(-50%);
+}
+
+nav button {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  align-items: center;
+  gap: 4px;
+  min-width: 0;
+  min-height: 48px;
+  padding: 4px 0;
+  border: 0;
+  background: none;
+  color: #647187;
+  font-size: 10px;
+  transition: color 0.2s;
+}
+
+nav button.active {
+  color: var(--accent);
+}
+
+/* ---------- Адаптивність ---------- */
+
 @media (max-width: 350px) {
-  .app { padding-left: 9px !important; padding-right: 9px !important; }
-  .app > header { grid-template-columns: 32px minmax(0, 1fr) max-content !important; column-gap: 6px !important; }
-  .app > header > .logo { width: 32px !important; min-width: 32px !important; height: 32px !important; }
-  .app > header > .online { font-size: 8px !important; }
+  :root { --gutter: max(10px, env(safe-area-inset-left), env(safe-area-inset-right)); }
+  .panel { padding: 14px; }
+  .rates { padding: 14px; }
+  .rates > div + div { padding-left: 11px; }
+  .admin-promo { flex-direction: column; align-items: stretch; }
+  .admin-promo .delete-promo { width: 100%; }
+}
+
+@media (max-width: 420px) {
+  .admin-promo { flex-direction: column; align-items: stretch; }
+  .admin-promo .delete-promo { width: 100%; }
+}
+
+@media (min-width: 600px) {
+  :root { --gutter: 25px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation: none;
+    transition: none;
+  }
 }
